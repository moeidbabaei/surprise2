<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>برای تو 💚</title>

<style>
*{
  box-sizing:border-box;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
  background:#01030b;
  font-family:Tahoma,Arial,sans-serif;
}

.scene{
  position:fixed;
  inset:0;
  overflow:hidden;

  background:
    radial-gradient(
      ellipse at 50% 52%,
      rgba(0,255,100,.12),
      transparent 40%
    ),
    radial-gradient(
      ellipse at 20% 20%,
      rgba(0,100,60,.18),
      transparent 35%
    ),
    linear-gradient(
      180deg,
      #01030c 0%,
      #021711 60%,
      #000504 100%
    );
}


/* =========================
   ستاره‌های آسمان
========================= */

.stars{
  position:absolute;
  inset:0;

  background-image:
    radial-gradient(2px 2px at 8% 18%,#fff,transparent),
    radial-gradient(1px 1px at 18% 42%,#fff,transparent),
    radial-gradient(2px 2px at 27% 12%,#fff,transparent),
    radial-gradient(1px 1px at 34% 70%,#fff,transparent),
    radial-gradient(2px 2px at 47% 26%,#fff,transparent),
    radial-gradient(1px 1px at 55% 78%,#fff,transparent),
    radial-gradient(2px 2px at 68% 17%,#fff,transparent),
    radial-gradient(1px 1px at 74% 55%,#fff,transparent),
    radial-gradient(2px 2px at 88% 27%,#fff,transparent),
    radial-gradient(1px 1px at 94% 75%,#fff,transparent);

  animation:twinkle 3s infinite alternate;
}


/* =========================
   ماه با جزئیات
========================= */

.moon{
  position:absolute;

  right:9%;
  top:10%;

  width:88px;
  height:88px;

  border-radius:50%;
  overflow:hidden;

  background:

    radial-gradient(
      circle at 34% 30%,
      rgba(255,255,255,.95) 0 5%,
      transparent 6%
    ),

    radial-gradient(
      circle at 62% 24%,
      rgba(95,105,125,.28) 0 9%,
      transparent 10%
    ),

    radial-gradient(
      circle at 28% 52%,
      rgba(90,100,120,.24) 0 13%,
      transparent 14%
    ),

    radial-gradient(
      circle at 67% 57%,
      rgba(85,95,115,.22) 0 11%,
      transparent 12%
    ),

    radial-gradient(
      circle at 48% 78%,
      rgba(80,90,110,.25) 0 8%,
      transparent 9%
    ),

    radial-gradient(
      circle at 35% 35%,
      #fff 0%,
      #e8eeff 42%,
      #bbc5d8 72%,
      #6d7892 100%
    );

  box-shadow:
    0 0 22px rgba(255,255,255,.45),
    0 0 55px rgba(160,190,210,.18),
    0 0 95px rgba(0,255,100,.10);

  opacity:.78;
}

.moon::before{
  content:"";

  position:absolute;
  inset:-2px;

  border-radius:50%;

  background:

    radial-gradient(
      circle at 72% 36%,
      rgba(70,80,100,.20) 0 7%,
      transparent 8%
    ),

    radial-gradient(
      circle at 55% 48%,
      rgba(70,80,100,.16) 0 5%,
      transparent 6%
    ),

    radial-gradient(
      circle at 18% 68%,
      rgba(70,80,100,.20) 0 8%,
      transparent 9%
    );

  mix-blend-mode:multiply;
}

.moon::after{
  content:"";

  position:absolute;
  inset:0;

  border-radius:50%;

  background:
    linear-gradient(
      110deg,
      rgba(255,255,255,.20),
      transparent 38%,
      rgba(30,40,60,.25)
    );
}


/* =========================
   شهاب سبز
========================= */

.comet{
  position:absolute;

  left:-150px;
  top:18%;

  width:27px;
  height:27px;

  border-radius:50%;

  background:#39ff14;

  z-index:8;

  box-shadow:
    0 0 6px 2px #fff,
    0 0 15px 5px #39ff14,
    0 0 40px 15px #00ff66,
    0 0 90px 35px rgba(0,255,100,.45);

  animation:
    fly 5.2s cubic-bezier(.16,.67,.27,1) forwards;
}


/* رد نور شهاب */

.comet::before{
  content:"";

  position:absolute;

  right:6px;
  top:50%;

  width:500px;
  height:13px;

  transform:translateY(-50%);

  border-radius:50%;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(0,255,80,.08),
      rgba(90,255,150,.5),
      #39ff14
    );

  filter:blur(3px);

  box-shadow:
    0 0 25px #00ff66;
}


/* ذرات نور */

.comet::after{
  content:"✦  ·  ✧  ·  ✦  ·  ✧";

  position:absolute;

  right:70px;
  top:-45px;

  width:380px;

  color:#baffc9;

  font-size:18px;
  letter-spacing:20px;

  opacity:.8;

  animation:
    sparkle .8s infinite alternate;
}


/* =========================
   متن‌ها
========================= */

.message{
  position:absolute;

  left:50%;
  top:50%;

  transform:
    translate(-50%,-50%)
    scale(.8);

  width:92%;

  text-align:center;

  color:white;

  opacity:0;

  z-index:10;

  text-shadow:
    0 0 8px #fff,
    0 0 25px #39ff14,
    0 0 55px #00ff66;
}


/* متن دوم */

.two{
  font-size:clamp(22px,5vw,48px);

  animation:
    showMessage 1s ease 5.5s forwards,
    hideMessage 1s ease 9.3s forwards;
}


/* متن سوم */

.three{
  font-size:clamp(30px,8vw,75px);

  font-weight:bold;

  animation:
    showMessage 1.5s ease 10s forwards;
}


/* =========================
   خط نور
========================= */

.line{
  position:absolute;

  left:50%;
  top:64%;

  transform:translateX(-50%);

  width:0;
  height:1px;

  background:
    linear-gradient(
      90deg,
      transparent,
      #39ff14,
      transparent
    );

  box-shadow:
    0 0 15px #39ff14,
    0 0 35px #00ff66;

  animation:
    lineShow 1.5s ease 10.7s forwards;
}


/* =========================
   تاریکی سینمایی
========================= */

.vignette{
  position:absolute;

  inset:-5%;

  box-shadow:
    inset 0 0 180px 55px #000;

  z-index:20;

  pointer-events:none;
}


/* =========================
   انیمیشن شهاب
========================= */

@keyframes fly{

  0%{
    left:-150px;
    top:15%;

    transform:
      rotate(-11deg)
      scale(.65);
  }

  48%{
    left:45%;
    top:43%;

    transform:
      rotate(-11deg)
      scale(1.3);
  }

  100%{
    left:120%;
    top:78%;

    transform:
      rotate(-11deg)
      scale(.6);
  }
}


/* =========================
   ظاهر شدن متن
========================= */

@keyframes showMessage{

  0%{
    opacity:0;

    transform:
      translate(-50%,-50%)
      scale(.6);

    filter:blur(15px);
  }

  60%{
    opacity:1;
  }

  100%{
    opacity:1;

    transform:
      translate(-50%,-50%)
      scale(1);

    filter:blur(0);
  }
}


/* =========================
   محو شدن متن
========================= */

@keyframes hideMessage{

  0%{
    opacity:1;

    filter:blur(0);

    transform:
      translate(-50%,-50%)
      scale(1);
  }

  100%{
    opacity:0;

    filter:blur(8px);

    transform:
      translate(-50%,-50%)
      scale(1.08);
  }
}


/* =========================
   درخشش ذرات
========================= */

@keyframes sparkle{

  from{
    opacity:.25;

    transform:
      translateX(0);
  }

  to{
    opacity:1;

    transform:
      translateX(-20px);
  }
}


/* =========================
   خط نور
========================= */

@keyframes lineShow{

  to{
    width:min(70vw,650px);

    opacity:.8;
  }
}


/* =========================
   چشمک ستاره‌ها
========================= */

@keyframes twinkle{

  to{
    opacity:.45;
  }
}


/* =========================
   موبایل
========================= */

@media(max-width:600px){

  .moon{
    width:60px;
    height:60px;
  }

  .comet::before{
    width:300px;
  }

  .message{
    width:94%;
  }
}

</style>
</head>

<body>

<div class="scene">

  <div class="stars"></div>

  <div class="moon"></div>

  <div class="comet"></div>


  <!-- متن اول -->

  <div class="message two">
    بین میلیاردها ستاره، یه نفر هست که برای من از همه‌شون روشن‌تره… تو ✨💚
  </div>


  <!-- متن دوم  -->

  <div class="message three">
    فرزاد فدای تو بشه 💚✨
  </div>


  <div class="line"></div>

  <div class="vignette"></div>

</div>

</body>
</html>
